#define ZMK_POINTING_DEFAULT_SCRL_VAL 200

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/mouse.h>

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&lt {
    quick-tap-ms = <300>;
};


/ {
    macros {
        emoji: emoji_macro {
            compatible = "zmk,behavior-macro";
            label = "EMOJI";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp CAPSLOCK>,
                <&macro_tap &kp E>,
                <&macro_release &kp CAPSLOCK>;
        };

        // Cmd+Shift+= (Cmd+"+" = 拡大)を、単一パラメータに複数の修飾キーを
        // 詰め込む方式(&kp LS(LG(EQUAL)))ではなく、絵文字マクロと同じ
        // 明示的な押す→押す→タップ→離す→離すの手順にした。エンコーダー
        // 経由のCmd+Shift+=がZoom Layerで反応しなかったための対策。
        zoom_in: zoom_in_macro {
            compatible = "zmk,behavior-macro";
            label = "ZOOM_IN";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LGUI>,
                <&macro_press &kp LSHIFT>,
                <&macro_tap &kp EQUAL>,
                <&macro_release &kp LSHIFT>,
                <&macro_release &kp LGUI>;
        };
    };

    behaviors {
        encoder_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <20>;
        };

        encoder_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        // Zoom Layer専用。1つ目(cw)は普通の&kp(縮小=Cmd+-、実機で動作確認済み)、
        // 2つ目(ccw)はzoom_inマクロ固定(拡大)。マクロ側は#binding-cells=0な
        // ので、use-site側の2個目の引数(0)は無視される。
        // tap-msを既定の5msから伸ばしている: sensor-rotateは「押す→tap-ms後に
        // 離す」を合成するが、zoom_inマクロは内部に5ステップ(既定でも
        // 15〜30ms間隔)あり、5msでは「離す」が先に処理されてしまい拡大が
        // 反応しなかった。マクロが完走できるよう十分な余裕を持たせた
        encoder_zoom: sensor_rotate_zoom {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&zoom_in>;
            tap-ms = <150>;
        };
    };

    // I+O同時押しでGesture Layer(6)に一時的に切替。トラックボールの
    // スワイプ検出(trackball.overlayのlism_gesture)と組み合わせて、
    // デスクトップ移動/Mission Controlのジェスチャーを実現する。
    // 再有効化(2026-07-10): lism_gesture.cをセンサー処理から切り離す
    // より安全な設計に書き直した版でクリーン検証中。
    combos {
        compatible = "zmk,combos";
        combo_gesture_layer {
            timeout-ms = <50>;
            key-positions = <7 8>;
            bindings = <&mo 6>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
                &kp Q            &kp W              &kp E                 &kp R                   &kp T                                                  &kp Y          &kp U            &kp I              &kp O               &kp P
                &kp A            &mt LALT S         &mt LSHIFT D          &mt LGUI F              &mt LCTRL G                                            &mt RCTRL H    &mt RGUI J       &mt RSHIFT K       &mt RALT L          &lt 3 SEMICOLON
                &kp Z            &kp X              &kp C                 &kp V                   &kp B                                                  &kp N          &kp M            &kp COMMA          &kp DOT             &kp SLASH
                &lt 4 DELETE     &tog 1             &lt 1 TAB             &msc SCRL_UP            &lt 2 SPACE       &lt 3 ESC           &lt 3 BACKSPACE  &lt 2 ENTER    &msc SCRL_UP     &kp F7             &kp F10             &lt 4 F12 
                                                    &msc SCRL_LEFT        &msc SCRL_DOWN          &msc SCRL_RIGHT                                        &msc SCRL_LEFT &msc SCRL_DOWN   &msc SCRL_RIGHT
            >;
            sensor-bindings = <&encoder_msc SCRL_UP SCRL_DOWN>;
        };

        layer_1 {
            display-name = "Mouse Layer";
            bindings = <
                &trans           &trans             &trans                &trans                  &trans                                                 &kp SPACE      &kp RG(LEFT)     &kp RG(RIGHT)      &mkp MB3            &trans
                &mkp MB5         &trans             &trans                &trans                  &trans                                                 &kp LG(UP)     &mkp MB1         &mkp MB2           &msc SCRL_UP        &msc SCRL_DOWN
                &mkp MB4         &trans             &trans                &trans                  &trans                                                 &kp LG(DOWN)   &kp LEFT         &kp UP             &kp RIGHT           &trans
                &trans           &trans             &trans                &trans                  &trans            &trans              &trans           &trans         &trans           &kp DOWN           &trans              &kp LG(W)
                                                    &trans                &trans                  &trans                                                 &trans         &trans           &trans
            >;
        };

        layer_2 {
            display-name = "Number Layer";
            bindings = <
                &trans           &kp NUMBER_7       &kp NUMBER_8          &kp NUMBER_9            &kp EQUAL                                              &kp F1         &kp F2           &kp F7             &kp F10             &kp RSHIFT
                &kp ASTERISK     &mt LALT NUMBER_4  &mt LSHIFT NUMBER_5   &mt LGUI NUMBER_6       &mt LCTRL MINUS                                        &mkp MB1       &kp LEFT         &kp UP             &kp RIGHT           &kp RGUI
                &kp SLASH        &kp NUMBER_1       &kp NUMBER_2          &kp NUMBER_3            &kp PLUS                                               &mkp MB2       &none            &kp DOWN           &none               &kp RALT
                &trans           &kp DOT            &kp NUMBER_0          &kp UP                  &kp LANG2         &trans              &trans           &kp LANG1      &kp UP           &kp RS(RC(TAB))    &kp RC(TAB)         &kp F12 
                                                    &kp LEFT              &kp DOWN                &kp RIGHT                                              &kp LEFT       &kp DOWN         &kp RIGHT
            >;
            sensor-bindings = <&encoder_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            display-name = "Mark Layer";
            bindings = <
                &kp LS(LG(N4))   &kp F4             &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS   &none                                                  &kp TILDE      &kp EXCLAMATION  &kp AT_SIGN        &kp HASH            &kp DOLLAR
                &emoji           &kp F5             &kp LEFT_BRACKET      &kp RIGHT_BRACKET       &none                                                  &kp GRAVE      &kp UNDER        &kp SINGLE_QUOTE   &kp DOUBLE_QUOTES   &kp BACKSLASH
                &kp KP_NUMLOCK   &kp F11            &kp LEFT_BRACE        &kp RIGHT_BRACE         &none                                                  &kp PIPE       &kp PERCENT      &kp CARET          &kp AMPERSAND       &kp ASTERISK
                &trans           &trans             &kp NUMBER_0          &trans                  &kp SPACE         &trans              &trans           &kp ENTER      &trans           &none              &none               &kp F12 
                                                    &trans                &trans                  &trans                                                 &trans         &trans           &trans
            >;
        };

        layer_4 {
            display-name = "Device Layer";
            bindings = <
                &none            &none              &none                 &none                   &bt BT_CLR                                             &bt BT_SEL 0   &bt BT_SEL 1     &bt BT_SEL 2       &bt BT_SEL 3        &bt BT_SEL 4
                &none            &none              &none                 &none                   &none                                                  &none          &none            &none              &none               &none
                &sys_reset       &none              &none                 &none                   &none                                                  &none          &none            &none              &none               &sys_reset
                &bootloader      &bt BT_CLR_ALL     &none                 &none                   &none             &none               &studio_unlock   &none          &none            &none              &none               &bootloader
                                                    &trans                &trans                  &trans                                                 &trans         &trans           &trans
            >;
        };

        // マウスレイヤー上でコンボ(2キー同時押し)を押している間だけ一時的に
        // 重なる透明なレイヤー。キー割り当ては全部&trans(素通し)のままで、
        // エンコーダーの回転だけをズーム(Cmd+ / Cmd-)に差し替える。
        // ジェスチャーレイヤー(layer_6)と全く同じ考え方。
        layer_5 {
            display-name = "Zoom Layer";
            bindings = <
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans            &trans              &trans           &trans       &trans           &trans             &trans              &trans
                                                    &trans                &trans                  &trans                                                 &trans       &trans           &trans
            >;
            // 実機確認(2026-07-11): 親指を左に回す方向が拡大になるよう調整済み。
            // 拡大側はCmd+Shift+=を単一パラメータにまとめる方式(LS(LG(EQUAL)))が
            // 実機で反応しなかったため、encoder_zoom(マクロで明示的に押す→
            // 押す→タップ→離す→離す)に切り替えた。縮小(Cmd+-)は元々動作していた
            // ため&kpのまま。2個目の引数(0)はzoom_inマクロ側では使われない
            sensor-bindings = <&encoder_zoom LG(MINUS) 0>;
        };

        layer_6 {
            display-name = "Gesture Layer";
            bindings = <
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans            &trans              &trans           &trans       &trans           &trans             &trans              &trans
                                                    &trans                &trans                  &trans                                                 &trans       &trans           &trans
            >;
        };

        layer_7 {
            status = "reserved";
            display-name = "Brank Layer";
            bindings = <
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans            &trans              &trans           &trans       &trans           &trans             &trans              &trans
                                                    &trans                &trans                  &trans                                                 &trans       &trans           &trans
            >;
        };
    };

};